# Replace ai.example.com with your real hostname. Both routes still require app authentication.
ai.example.com {
    handle /api/models/import {
        request_body {
            max_size 21GB
        }
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }
    handle {
        request_body {
            max_size 26MB
        }
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }
}
