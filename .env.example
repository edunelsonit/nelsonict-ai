# Copy to .env before starting. No external AI credentials are required.
NELSON_DATA_DIR=data
NELSON_MODELS_DIR=models
# Optional local Sentence Transformers model directory; blank means keyword search.
NELSON_EMBEDDING_MODEL=
NELSON_ALLOWED_HOSTS=localhost,127.0.0.1
# Set true when serving through HTTPS.
NELSON_COOKIE_SECURE=false
NELSON_SESSION_HOURS=24
NELSON_MAX_UPLOAD_MB=25
NELSON_USER_STORAGE_MB=250
NELSON_MAX_PAGES=300
NELSON_MAX_CHUNKS=10000
NELSON_INDEX_TIMEOUT=600
NELSON_OCR_LANGUAGE=eng
# Docker publishes locally by default. Use 0.0.0.0 for authorised LAN access.
NELSON_BIND_ADDRESS=127.0.0.1
NELSON_PORT=8000

# Administrator GGUF imports (MB) and full-document analysis limit (passages).
NELSON_MAX_MODEL_MB=20480
NELSON_MAX_SUMMARY_CHUNKS=256

# v1.2 queue, guided restore, and native managed launcher.
NELSON_QUEUE_LIMIT=32
NELSON_QUEUE_PER_USER=2
NELSON_QUEUE_TIMEOUT=600
NELSON_MAX_BACKUP_MB=2048
NELSON_BIND_HOST=127.0.0.1
NELSON_BIND_PORT=8000
